OPENBOX_API_URL=https://core.example.com
OPENBOX_API_KEY=obx_test_replace_me
OPENBOX_AGENT_IDENTITY_METHOD=keycloak_workload
# Supply the active service account's complete PKCS8 PEM RSA key from a secret store.
OPENBOX_WORKLOAD_PRIVATE_KEY=
# OPENBOX_MASTRA_* identity/connection variables override their global equivalents.
# Blank prefixed values fall through to the global value.
OPENBOX_GOVERNANCE_POLICY=fail_closed
